                                                       :act_summ_max_altitude_m ,
                                                       :act_summ_max_hr ,
                                                       :act_summ_max_power ,
                                                       :act_summ_max_speed_mps ,
                                                       :act_summ_max_weather_temp_c ,
                                                       :act_summ_min_altitude_m ,
                                                       :act_summ_min_weather_temp_c ,
                                                       :act_summ_moving_time_sec ,
                                                       :act_summ_tailwind_percent ,
                                                       :act_summ_weather_temp_c ,
                                                       :act_summ_wind_gust_mps ,
                                                       :act_summ_wind_speed_mps ,
                                                       :act_summ_work_joules ,
                                                       :act_summ_wprime_joules ;
                            :containsActivityIndex :act_summ_aerobic_decoupling ,
                                                   :act_summ_athlete_weight_kg ,
                                                   :act_summ_efficiency_factor ,
                                                   :act_summ_ftp_watts ,
                                                   :act_summ_hr_load ,
                                                   :act_summ_intensity ,
                                                   :act_summ_lactate_threshold_hr ,
                                                   :act_summ_normalized_power ,
                                                   :act_summ_polarization_index ,
                                                   :act_summ_power_load ,
                                                   :act_summ_strain_score ,
                                                   :act_summ_training_load ,
                                                   :act_summ_chronic_training_load ,
                                                   :act_summ_acute_training_load ,
                                                   :act_summ_trimp ,
                                                   :act_summ_variability_index ,
                                                   :act_summ_workout_compliance ;
                            :groupedBy :act_summ_activity_id ;
                            :hasKey :act_summ_activity_id ,
                                    :act_summ_start_date_utc ,
                                    :act_summ_type .


