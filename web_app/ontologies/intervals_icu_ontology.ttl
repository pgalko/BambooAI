                        :recordedWithFrequency "Per Interval" .


#int_summ_average_weather_temp
:int_summ_average_weather_temp rdf:type owl:NamedIndividual ,
                                        :DirectlyMeasured ,
                                        :Environmental ,
                                        :IntervalAggregate ;
                               :hasRelation :int_summ_lap_number ;
                               :isPresentInDataset "true"^^xsd:boolean ;
                               :measuredInUnits "Celsius" ;
                               :recordedWithFrequency "Per Interval" .


#int_summ_average_wind_gust
:int_summ_average_wind_gust rdf:type owl:NamedIndividual ,
                                     :DirectlyMeasured ,
                                     :Environmental ,
                                     :IntervalAggregate ;
                            :hasRelation :int_summ_lap_number ;
                            :isPresentInDataset "true"^^xsd:boolean ;
                            :measuredInUnits "Meters per second" ;
                            :recordedWithFrequency "Per Interval" .


#int_summ_average_wind_speed
:int_summ_average_wind_speed rdf:type owl:NamedIndividual ,
                                      :DirectlyMeasured ,
                                      :Environmental ,
                                      :IntervalAggregate ;
                             :hasRelation :int_summ_lap_number ;
                             :isPresentInDataset "true"^^xsd:boolean ;
                             :measuredInUnits "Meters per second" ;
                             :recordedWithFrequency "Per Interval" .


#int_summ_average_yaw
:int_summ_average_yaw rdf:type owl:NamedIndividual ,
                               :DirectlyMeasured ,
                               :Environmental ,
                               :IntervalAggregate ;
                      :hasRelation :int_summ_lap_number ;
                      :isPresentInDataset "true"^^xsd:boolean ;
                      :measuredInUnits "Degrees" ;
                      :recordedWithFrequency "Per Interval" .


#int_summ_avg_lr_balance
:int_summ_avg_lr_balance rdf:type owl:NamedIndividual ,
                                  :DirectlyMeasured ,
                                  :IntervalAggregate ,
                                  :Mechanical ;
                         :hasRelation :int_summ_lap_number ;
                         :isPresentInDataset "true"^^xsd:boolean ;
                         :measuredInUnits "Percent" ;
                         :recordedWithFrequency "Per Interval" .


#int_summ_distance
:int_summ_distance rdf:type owl:NamedIndividual ,
                            :DirectlyMeasured ,
                            :Geospatial ,
                            :IntervalAggregate ;
                   :hasRelation :int_summ_lap_number ;
                   :isPresentInDataset "true"^^xsd:boolean ;
                   :measuredInUnits "meters" ;
                   :recordedWithFrequency "Per Interval" .


#int_summ_elapsed_time
:int_summ_elapsed_time rdf:type owl:NamedIndividual ,
                                :DirectlyMeasured ,
                                :IntervalAggregate ,
                                :Temporal ;
                       :hasRelation :int_summ_lap_number ;
                       :isPresentInDataset "true"^^xsd:boolean ;
                       :measuredInUnits "Seconds" ;
                       :recordedWithFrequency "Per Interval" .


#int_summ_end_time
:int_summ_end_time rdf:type owl:NamedIndividual ,
                            :DirectlyMeasured ,
                            :IntervalAggregate ,
                            :Key ,
                            :Temporal ;
                   :hasRelation :int_summ_lap_number ;
                   :isPresentInDataset "true"^^xsd:boolean ;
                   :measuredInUnits "Seconds" ;
                   :recordedWithFrequency "Per Interval" ;
                   rdfs:comment "Seconds elapsed from activity start, signifying the end of the interval (lap)" .


#int_summ_headwind_percent
:int_summ_headwind_percent rdf:type owl:NamedIndividual ,
                                    :DirectlyMeasured ,
                                    :Environmental ,
                                    :IntervalAggregate ;
                           :hasRelation :int_summ_lap_number ;
                           :isPresentInDataset "true"^^xsd:boolean ;
                           :measuredInUnits "Percent" ;
                           :recordedWithFrequency "Per Interval" .


#int_summ_joules
:int_summ_joules rdf:type owl:NamedIndividual ,
                          :DirectlyMeasured ,
                          :IntervalAggregate ,
                          :Metabolic ;
                 :hasRelation :int_summ_lap_number ;
                 :isPresentInDataset "true"^^xsd:boolean ;
                 :measuredInUnits "Joules" ;
                 :recordedWithFrequency "Per Interval" .


#int_summ_lactate
:int_summ_lactate rdf:type owl:NamedIndividual ,
                          :DirectlyMeasured ,
                          :IntervalAggregate ,
                          :Metabolic ;
                 :hasRelation :int_summ_lap_number ;
                 :isPresentInDataset "true"^^xsd:boolean ;
                 :measuredInUnits "Millimoles per liter (mmol/L)" ;
                 :recordedWithFrequency "Per Interval" ;
                 rdfs:comment "Lactate concentration measured during the interval (lap)" .


#int_summ_rpe
:int_summ_rpe rdf:type owl:NamedIndividual ,
                          :Assessed ,
                          :IntervalAggregate ,
                          :TrainingStress ;
                 :hasRelation :int_summ_lap_number ;
                 :isPresentInDataset "true"^^xsd:boolean ;
                 :measuredInUnits "Rating of Perceived Exertion (1-10 scale)" ; 
                 :recordedWithFrequency "Per Interval" ;
                 rdfs:comment "Rate of perceived exertion. 1 - Rest 2 - Really easy 3 - Easy 4 - Moderate 5 - Challenging 6 - Hard 7 - Really Hard 8 - Really, really hard 9 - Maximal" .


#int_summ_label
:int_summ_label rdf:type owl:NamedIndividual ,
                          :Key ;
                 :hasRelation :int_summ_lap_number ;
                 :isPresentInDataset "true"^^xsd:boolean ;
                 :recordedWithFrequency "Per Interval" ;
                 rdfs:comment "Interval Category Label" .


#int_summ_lap_number
:int_summ_lap_number rdf:type owl:NamedIndividual ,
                              :Key ;
                     :hasRelation :int_summ_activity_id ;
                     :isPresentInDataset "true"^^xsd:boolean ;
                     :recordedWithFrequency "Per Interval" .


#int_summ_max_altitude
:int_summ_max_altitude rdf:type owl:NamedIndividual ,
                                :DirectlyMeasured ,
                                :Geospatial ,
                                :IntervalAggregate ;
                       :hasRelation :int_summ_lap_number ;
                       :isPresentInDataset "true"^^xsd:boolean ;
                       :measuredInUnits "Meters" ;
                       :recordedWithFrequency "Per Interval" .


#int_summ_min_altitude
:int_summ_min_altitude rdf:type owl:NamedIndividual ,
                                :DirectlyMeasured ,
                                :Geospatial ,
                                :IntervalAggregate ;
                       :hasRelation :int_summ_lap_number ;
                       :isPresentInDataset "true"^^xsd:boolean ;
                       :measuredInUnits "Meters" ;
                       :recordedWithFrequency "Per Interval" .


#int_summ_moving_time
:int_summ_moving_time rdf:type owl:NamedIndividual ,
                               :DirectlyMeasured ,
                               :IntervalAggregate ,
                               :Temporal ;
                      :hasRelation :int_summ_lap_number ;
                      :isPresentInDataset "true"^^xsd:boolean ;
                      :measuredInUnits "Seconds" ;
                      :recordedWithFrequency "Per Interval" .


#int_summ_prevailing_wind_deg
:int_summ_prevailing_wind_deg rdf:type owl:NamedIndividual ,
                                       :DirectlyMeasured ,
                                       :Environmental ,
                                       :IntervalAggregate ;
                              :hasRelation :int_summ_lap_number ;
                              :isPresentInDataset "true"^^xsd:boolean ;
                              :measuredInUnits "Degrees" ;
                              :recordedWithFrequency "Per Interval" .


#int_summ_start_time
:int_summ_start_time rdf:type owl:NamedIndividual ,
                              :DirectlyMeasured ,
                              :IntervalAggregate ,
                              :Key ,
                              :Temporal ;
                     :hasRelation :int_summ_lap_number ;
                     :isPresentInDataset "true"^^xsd:boolean ;
                     :measuredInUnits "Seconds" ;
                     :recordedWithFrequency "Per Interval" ;
                     rdfs:comment "Seconds elapsed from activity start, signifying the start of interval (lap)" .


#int_summ_tailwind_percent
:int_summ_tailwind_percent rdf:type owl:NamedIndividual ,
                                    :DirectlyMeasured ,
                                    :Environmental ,
                                    :IntervalAggregate ;
                           :hasRelation :int_summ_lap_number ;
                           :isPresentInDataset "true"^^xsd:boolean ;
                           :measuredInUnits "Percent" ;
                           :recordedWithFrequency "Per Interval" .


#int_summ_total_elevation_gain
:int_summ_total_elevation_gain rdf:type owl:NamedIndividual ,
                                        :DirectlyMeasured ,
                                        :Geospatial ,
                                        :IntervalAggregate ;
                               :hasRelation :int_summ_lap_number ;
                               :isPresentInDataset "true"^^xsd:boolean ;
                               :measuredInUnits "Meters" ;
                               :recordedWithFrequency "Per Interval" .


#latitude
:latitude rdf:type owl:NamedIndividual ,
                   :ActivityMeasurement ,
                   :DirectlyMeasured ,
                   :Geospatial ;
          :hasRelation :activity_id ,
                       :activity_type ,
                       :datetime ;
          :isPresentInDataset "true"^^xsd:boolean ;
          :measuredInUnits "Degrees" ;
          :recordedWithFrequency "1 Second" .


#left_right_balance
:left_right_balance rdf:type owl:NamedIndividual ,
                             :ActivityMeasurement ,
                             :DirectlyMeasured ,
                             :Mechanical ;
                    :hasRelation :activity_id ,
                                 :activity_type ,
                                 :datetime ;
                    :isPresentInDataset "true"^^xsd:boolean ;
                    :measuredInUnits "Percent" ;
                    :recordedWithFrequency "1 Second" ;
                    rdfs:comment "A balance between right pedal strokes and left pedal strokes as applicable to cycling" .


#longitude
:longitude rdf:type owl:NamedIndividual ,
                    :ActivityMeasurement ,
                    :DirectlyMeasured ,
                    :Geospatial ;
           :hasRelation :activity_id ,
                        :activity_type ,
                        :datetime ;
           :isPresentInDataset "true"^^xsd:boolean ;
           :measuredInUnits "Degrees" ;
           :recordedWithFrequency "1 Second" .


#mean_max_curve
:mean_max_curve rdf:type owl:NamedIndividual ,
                         :List ,
                         :Mechanical ,
                         :Derived ;
                :canBeComputedUsingFunction :function_compute_mean_max_curve ;
                :derivedFrom :power ,
                             :datetime ;
                :hasRelation :activity_id ;
                :measuredInUnits "List of (duration_seconds, power_watts) tuples" ;
                :isPresentInDataset "false"^^xsd:boolean ;
                rdfs:comment "The complete power-duration curve showing maximum sustainable power at each sampled duration. Foundational metric from which FTP, CP, and power profiles are derived." .


#functional_threshold_power
:functional_threshold_power rdf:type owl:NamedIndividual ,
                                     :Scalar ,
                                     :Mechanical ,
                                     :Derived ;
                            :canBeComputedUsingFunction :function_compute_functional_threshold_power ;
                            :derivedFrom :power ,
                                         :datetime ;
                            :hasRelation :activity_id ;
                            :equivalentToPrecomputed :act_summ_ftp_watts ;
                            :measuredInUnits "Watts" ;
                            :isPresentInDataset "false"^^xsd:boolean ;
                            rdfs:comment "The highest power output sustainable for approximately one hour. Industry-standard threshold for setting training zones and tracking fitness in cycling. Equivalent to act_summ_ftp_watts when precomputed." .


#critical_power
:critical_power rdf:type owl:NamedIndividual ,
                         :Scalar ,
                         :Mechanical ,
                         :Derived ;
                :canBeComputedUsingFunction :function_compute_critical_power ;
                :derivedFrom :power ,
                             :datetime ;
                :hasRelation :activity_id ;
                :measuredInUnits "Watts" ;
                :isPresentInDataset "false"^^xsd:boolean ;
                rdfs:comment "The asymptotic power of the power-duration curve representing the boundary between sustainable and unsustainable exercise intensities. Mathematically defined as the power that can theoretically be maintained indefinitely. Always computed together with W' as a pair." .


#w_prime
:w_prime rdf:type owl:NamedIndividual ,
                  :Scalar ,
                  :Mechanical ,
                  :Derived ;
         :canBeComputedUsingFunction :function_compute_critical_power ;
         :derivedFrom :power ,
                      :datetime ;
         :hasRelation :activity_id ;
         :equivalentToPrecomputed :act_summ_wprime_joules ;
         :measuredInUnits "Joules" ;
         :isPresentInDataset "false"^^xsd:boolean ;
         rdfs:comment "The curvature constant of the power-duration hyperbola representing the finite amount of work that can be performed above critical power. Also known as anaerobic work capacity. Always computed together with CP as a pair. Equivalent to act_summ_wprime_joules when precomputed." .


#power_profile_percentiles
:power_profile_percentiles rdf:type owl:NamedIndividual ,
                                    :List ,
                                    :Mechanical ,
                                    :Derived ;
                           :canBeComputedUsingFunction :function_compute_power_profile_percentiles ;
                           :derivedFrom :mean_max_curve ;
                           :dependsOnDerivedMetric :mean_max_curve ;
                           :hasRelation :activity_id ;
                           :measuredInUnits "List of (duration_seconds, power_watts, percentile_rank, confidence_interval) tuples" ;
                           :isPresentInDataset "false"^^xsd:boolean ;
                           rdfs:comment "Percentile rankings of an athlete's power output at various durations compared to a reference population. Reveals relative strengths and weaknesses independent of absolute power. Depends on mean_max_curve being computed first." .


#normalized_power
:normalized_power rdf:type owl:NamedIndividual ,
                           :Scalar ,
                           :Mechanical ,
                           :Derived ;
                  :canBeComputedUsingFunction :function_compute_normalized_power ;
                  :derivedFrom :power ,
                               :datetime ;
                  :hasRelation :activity_id ;
                  :equivalentToPrecomputed :act_summ_normalized_power ;
                  :measuredInUnits "Watts" ;
                  :isPresentInDataset "false"^^xsd:boolean ;
                  rdfs:comment "Normalized Power represents the physiological cost of a variable-power effort as an equivalent steady-state power. Higher weighting of intense moments reflects the nonlinear metabolic cost of hard efforts. Equivalent to act_summ_normalized_power when precomputed." .


#variability_index
:variability_index rdf:type owl:NamedIndividual ,
                            :Scalar ,
                            :Mechanical ,
                            :Derived ;
                   :canBeComputedUsingFunction :function_compute_variability_index ;
                   :derivedFrom :power ;
                   :dependsOnDerivedMetric :normalized_power ;
                   :hasRelation :activity_id ;
                   :equivalentToPrecomputed :act_summ_variability_index ;
                   :addressesConcept :concept_pacing ;
                   :measuredInUnits "Dimensionless ratio" ;
                   :isPresentInDataset "false"^^xsd:boolean ;
                   rdfs:comment "Variability Index quantifies how variable the power output was during an activity. Ratio of NP to average power. Higher VI indicates more surges and recoveries, which is metabolically more costly than steady pacing. Equivalent to act_summ_variability_index when precomputed." .


#intensity_factor
:intensity_factor rdf:type owl:NamedIndividual ,
                           :Scalar ,
                           :Mechanical ,
                           :Derived ;
                  :canBeComputedUsingFunction :function_compute_intensity_factor ;
                  :derivedFrom :power ;
                  :dependsOnDerivedMetric :normalized_power ,
                                          :functional_threshold_power ;
                  :hasRelation :activity_id ;
                  :equivalentToPrecomputed :act_summ_intensity ;
                  :measuredInUnits "Dimensionless ratio" ;
                  :isPresentInDataset "false"^^xsd:boolean ;
                  rdfs:comment "Intensity Factor expresses workout intensity as a fraction of FTP (IF = NP/FTP), enabling comparison across athletes and over time as fitness changes. Equivalent to act_summ_intensity when precomputed." .


#training_stress_score
:training_stress_score rdf:type owl:NamedIndividual ,
                                :Scalar ,
                                :TrainingStress ,
                                :Derived ;
                       :canBeComputedUsingFunction :function_compute_training_stress_score ;
                       :derivedFrom :power ,
                                    :datetime ;
                       :dependsOnDerivedMetric :normalized_power ,
                                               :intensity_factor ,
                                               :functional_threshold_power ;
                       :hasRelation :activity_id ;
                       :equivalentToPrecomputed :act_summ_training_load ;
                       :measuredInUnits "TSS points (dimensionless)" ;
                       :isPresentInDataset "false"^^xsd:boolean ;
                       rdfs:comment "Training Stress Score integrates workout intensity and duration into a single training load metric. Normalized so that 1 hour at FTP = 100 TSS. Foundation for long-term training load tracking (CTL/ATL/TSB). Equivalent to act_summ_training_load when precomputed." .


#chronic_training_load
:chronic_training_load rdf:type owl:NamedIndividual ,
                                :Scalar ,
                                :TrainingStress ,
                                :Derived ;
                       :canBeComputedUsingFunction :function_compute_performance_management ;
                       :derivedFrom :training_stress_score ;
                       :dependsOnDerivedMetric :training_stress_score ;
                       :hasRelation :date ;
                       :equivalentToPrecomputed :well_ctl,  
                                                :act_summ_chronic_training_load ;
                       :addressesConcept :concept_fitness_fatigue_modeling ;
                       :measuredInUnits "TSS points (42-day exponentially weighted average)" ;
                       :isPresentInDataset "false"^^xsd:boolean ;
                       rdfs:comment "Chronic Training Load represents long-term training load and fitness. 42-day time constant exponentially weighted moving average of daily TSS. Higher CTL indicates greater accumulated fitness. Equivalent to well_ctl when precomputed." .


#acute_training_load
:acute_training_load rdf:type owl:NamedIndividual ,
                              :Scalar ,
                              :TrainingStress ,
                              :Derived ;
                     :canBeComputedUsingFunction :function_compute_performance_management ;
                     :derivedFrom :training_stress_score ;
                     :dependsOnDerivedMetric :training_stress_score ;
                     :hasRelation :date ;
                     :equivalentToPrecomputed :well_atl,  
                                              :act_summ_acute_training_load ;
                     :addressesConcept :concept_fitness_fatigue_modeling ;
                     :measuredInUnits "TSS points (7-day exponentially weighted average)" ;
                     :isPresentInDataset "false"^^xsd:boolean ;
                     rdfs:comment "Acute Training Load represents short-term training load and fatigue. 7-day time constant exponentially weighted moving average of daily TSS. Higher ATL indicates greater recent training stress/fatigue. Equivalent to well_atl when precomputed." .


#training_stress_balance
:training_stress_balance rdf:type owl:NamedIndividual ,
                                  :Scalar ,
                                  :TrainingStress ,
                                  :Derived ;
                         :canBeComputedUsingFunction :function_compute_performance_management ;
                         :derivedFrom :chronic_training_load ,
                                      :acute_training_load ;
                         :dependsOnDerivedMetric :chronic_training_load ,
                                                 :acute_training_load ;
                         :hasRelation :date ;
                         :addressesConcept :concept_fitness_fatigue_modeling ;
                         :measuredInUnits "TSS points (difference, can be negative)" ;
                         :isPresentInDataset "false"^^xsd:boolean ;
                         rdfs:comment "Training Stress Balance (Form) = CTL - ATL. Represents freshness/readiness. Positive TSB indicates freshness (fitness exceeds fatigue); negative indicates fatigue. Key metric for taper and race timing. Optimal race TSB typically +5 to +25." .


#w_prime_balance
:w_prime_balance rdf:type owl:NamedIndividual ,
                          :List ,
                          :Mechanical ,
                          :Derived ;
                 :canBeComputedUsingFunction :function_compute_w_prime_balance ;
                 :derivedFrom :power ,
                              :datetime ;
                 :dependsOnDerivedMetric :critical_power ,
                                         :w_prime ;
                 :hasRelation :activity_id ;
                 :measuredInUnits "Joules at each timestamp" ;
                 :isPresentInDataset "false"^^xsd:boolean ;
                 rdfs:comment "W' Balance tracks real-time anaerobic work capacity throughout an activity. Shows moment-by-moment fatigue state and recovery, essential for race analysis and pacing strategy. Depends on CP and W' being computed first." .


#ventilatory_threshold_1
:ventilatory_threshold_1 rdf:type owl:NamedIndividual ,
                                  :Scalar ,
                                  :Metabolic ,
                                  :Derived ;
                         :canBeComputedUsingFunction :function_detect_ventilatory_thresholds ;
                         :derivedFrom :tidal_volume_minute ,
                                      :respiration_rate ,
                                      :power ,
                                      :heart_rate ,
                                      :datetime ;
                         :hasRelation :activity_id ;
                         :measuredInUnits "Composite: power_watts, heart_rate_bpm, minute_ventilation_L_min" ;
                         :isPresentInDataset "false"^^xsd:boolean ;
                         rdfs:comment "First ventilatory threshold (VT1) marking the intensity at maximal fat oxidation. Corresponds to the first non-linear increase in minute ventilation relative to power. Training at or below VT1 maximizes aerobic development and fat adaptation. Computed together with VT2 and Balance Point as a set." .


#ventilatory_threshold_2
:ventilatory_threshold_2 rdf:type owl:NamedIndividual ,
                                  :Scalar ,
                                  :Metabolic ,
                                  :Derived ;
                         :canBeComputedUsingFunction :function_detect_ventilatory_thresholds ;
                         :derivedFrom :tidal_volume_minute ,
                                      :respiration_rate ,
                                      :power ,
                                      :heart_rate ,
                                      :datetime ;
                         :hasRelation :activity_id ;
                         :measuredInUnits "Composite: power_watts, heart_rate_bpm, minute_ventilation_L_min" ;
                         :isPresentInDataset "false"^^xsd:boolean ;
                         rdfs:comment "Second ventilatory threshold (VT2) marking the respiratory compensation point. Corresponds to the second sharp increase in minute ventilation where the body can no longer buffer lactate accumulation. Training above VT2 improves lactate tolerance but accumulates significant fatigue. Computed together with VT1 and Balance Point as a set." .


#balance_point
:balance_point rdf:type owl:NamedIndividual ,
                        :Scalar ,
                        :Metabolic ,
                        :Derived ;
               :canBeComputedUsingFunction :function_detect_ventilatory_thresholds ;
               :derivedFrom :tidal_volume_minute ,
                            :respiration_rate ,
                            :power ,
                            :heart_rate ,
                            :datetime ;
               :hasRelation :activity_id ;
               :measuredInUnits "Composite: power_watts, heart_rate_bpm, minute_ventilation_L_min" ;
               :isPresentInDataset "false"^^xsd:boolean ;
               rdfs:comment "Intermediate threshold between VT1 and VT2 where fat utilization begins declining rapidly and carbohydrate becomes the dominant fuel source. Useful for setting 'tempo' or 'sweetspot' training zones. Computed together with VT1 and VT2 as a set." .


#breathing_efficiency_index
:breathing_efficiency_index rdf:type owl:NamedIndividual ,
                                     :Scalar ,
                                     :Metabolic ,
                                     :Derived ;
                            :canBeComputedUsingFunction :function_compute_breathing_efficiency ;
                            :derivedFrom :tidal_volume_minute ,
                                         :power ,
                                         :datetime ;
                            :hasRelation :activity_id ;
                            :measuredInUnits "L/min/W (liters of ventilation per watt of power)" ;
                            :isPresentInDataset "false"^^xsd:boolean ;
                            rdfs:comment "Single-value ratio of minute ventilation to power output for a steady-state interval. Lower values indicate better metabolic efficiency - less breathing required per watt produced. Useful for tracking aerobic adaptations over time at matched intensities." .


#breathing_efficiency_curve
:breathing_efficiency_curve rdf:type owl:NamedIndividual ,
                                     :List ,
                                     :Metabolic ,
                                     :Derived ;
                            :canBeComputedUsingFunction :function_compute_breathing_efficiency ;
                            :derivedFrom :tidal_volume_minute ,
                                         :power ,
                                         :datetime ;
                            :hasRelation :activity_id ;
                            :measuredInUnits "List of (power_zone_watts, efficiency_ratio_L_min_W) tuples" ;
                            :isPresentInDataset "false"^^xsd:boolean ;
                            rdfs:comment "Profile of breathing efficiency across multiple power zones. Shows how efficiency degrades with increasing intensity, particularly above ventilatory thresholds. Useful for identifying intensity-specific efficiency changes." .


#ventilatory_drift_rate
:ventilatory_drift_rate rdf:type owl:NamedIndividual ,
                                 :Scalar ,
                                 :Metabolic ,
                                 :Derived ;
                        :canBeComputedUsingFunction :function_compute_ventilatory_drift ;
                        :derivedFrom :respiration_rate ,
                                     :tidal_volume ,
                                     :power ,
                                     :datetime ;
                        :hasRelation :activity_id ;
                        :measuredInUnits "breaths/min/hour" ;
                        :isPresentInDataset "false"^^xsd:boolean ;
                        rdfs:comment "Rate at which breathing rate increases during sustained effort while minute ventilation remains stable. A sensitive marker of internal load and fatigue accumulation - faster drift (>5 breaths/min/hour) indicates greater physiological strain. Computed together with tidal_volume_trend and ve_stability_coefficient. Power is required for validating constant-intensity assumption." .


#tidal_volume_trend
:tidal_volume_trend rdf:type owl:NamedIndividual ,
                             :Scalar ,
                             :Metabolic ,
                             :Derived ;
                    :canBeComputedUsingFunction :function_compute_ventilatory_drift ;
                    :derivedFrom :tidal_volume ,
                                 :power ,
                                 :datetime ;
                    :hasRelation :activity_id ;
                    :measuredInUnits "mL/hour" ;
                    :isPresentInDataset "false"^^xsd:boolean ;
                    rdfs:comment "Rate at which tidal volume decreases during sustained effort (typically negative). Accompanies breathing rate drift as a compensatory response to respiratory muscle fatigue. Faster decline indicates greater fatigue accumulation. Computed together with ventilatory_drift_rate and ve_stability_coefficient." .


#ve_stability_coefficient
:ve_stability_coefficient rdf:type owl:NamedIndividual ,
                                   :Scalar ,
                                   :Metabolic ,
                                   :Derived ;
                          :canBeComputedUsingFunction :function_compute_ventilatory_drift ;
                          :derivedFrom :tidal_volume_minute ,
                                       :power ,
                                       :datetime ;
                          :hasRelation :activity_id ;
                          :measuredInUnits "Percentage (coefficient of variation)" ;
                          :isPresentInDataset "false"^^xsd:boolean ;
                          rdfs:comment "Coefficient of variation of minute ventilation during sustained effort. Indicates VE stability: <5% = very stable (sustainable effort), 5-10% = normal variation, >10% = unstable (intensity changes or fatigue). Computed together with ventilatory_drift_rate and tidal_volume_trend." .


#estimated_fuel_mix
:estimated_fuel_mix rdf:type owl:NamedIndividual ,
                             :List ,
                             :Metabolic ,
                             :Derived ;
                    :canBeComputedUsingFunction :function_estimate_fuel_utilization ;
                    :derivedFrom :tidal_volume_minute ,
                                 :power ,
                                 :datetime ;
                    :dependsOnDerivedMetric :ventilatory_threshold_1 ,
                                            :ventilatory_threshold_2 ,
                                            :balance_point ;
                    :hasRelation :activity_id ;
                    :measuredInUnits "List of (timestamp, fat_percent, carb_percent, confidence_level) tuples" ;
                    :isPresentInDataset "false"^^xsd:boolean ;
                    rdfs:comment "ESTIMATED fuel utilization over time based on intensity relative to ventilatory thresholds. Provides approximate fat/carbohydrate percentages for nutrition planning. This is an estimate with inherent uncertainty - not a direct measurement like RER from metabolic cart." .


#efficiency_factor
:efficiency_factor rdf:type owl:NamedIndividual ,
                            :Scalar ,
                            :Metabolic ,
                            :Derived ;
                   :canBeComputedUsingFunction :function_compute_efficiency_factor ;
                   :derivedFrom :heart_rate ,
                                :power ,
                                :datetime ;
                   :hasRelation :activity_id ;
                   :equivalentToPrecomputed :act_summ_efficiency_factor ;
                   :measuredInUnits "W/bpm (watts per beat per minute)" ;
                   :isPresentInDataset "false"^^xsd:boolean ;
                   rdfs:comment "Ratio of power output to heart rate indicating cardiovascular efficiency. Higher values (1.5-2.2 W/bpm for aerobic efforts) indicate better aerobic fitness - more power produced per heartbeat. Track over time to monitor aerobic adaptation. Equivalent to act_summ_efficiency_factor when precomputed." .


#cardiac_drift_absolute
:cardiac_drift_absolute rdf:type owl:NamedIndividual ,
                                 :Scalar ,
                                 :Metabolic ,
                                 :Derived ;
                        :canBeComputedUsingFunction :function_compute_cardiac_drift ;
                        :derivedFrom :heart_rate ,
                                     :power ,
                                     :datetime ;
                        :hasRelation :activity_id ;
                        :measuredInUnits "bpm (beats per minute increase)" ;
                        :isPresentInDataset "false"^^xsd:boolean ;
                        rdfs:comment "Heart rate increase in absolute bpm from first to second half of sustained effort at constant power. Lower drift indicates better aerobic base fitness. Computed together with cardiac_drift_percentage and aerobic_decoupling." .


#cardiac_drift_percentage
:cardiac_drift_percentage rdf:type owl:NamedIndividual ,
                                   :Scalar ,
                                   :Metabolic ,
                                   :Derived ;
                          :canBeComputedUsingFunction :function_compute_cardiac_drift ;
                          :derivedFrom :heart_rate ,
                                       :power ,
                                       :datetime ;
                          :hasRelation :activity_id ;
                          :measuredInUnits "Percentage (%)" ;
                          :isPresentInDataset "false"^^xsd:boolean ;
                          rdfs:comment "Heart rate increase as percentage of first-half HR during sustained effort at constant power. Guidelines: <5% = good aerobic base, 5-10% = moderate, >10% = intensity exceeds aerobic capacity. Computed together with cardiac_drift_absolute and aerobic_decoupling." .


#aerobic_decoupling
:aerobic_decoupling rdf:type owl:NamedIndividual ,
                             :Scalar ,
                             :Metabolic ,
                             :Derived ;
                    :canBeComputedUsingFunction :function_compute_cardiac_drift ;
                    :derivedFrom :heart_rate ,
                                 :power ,
                                 :datetime ;
                    :dependsOnDerivedMetric :efficiency_factor ;
                    :hasRelation :activity_id ;
                    :equivalentToPrecomputed :act_summ_aerobic_decoupling ;
                    :measuredInUnits "Percentage (%)" ;
                    :isPresentInDataset "false"^^xsd:boolean ;
                    rdfs:comment "Percentage difference in Efficiency Factor between first and second half of effort. Pa:Hr decoupling <5% indicates excellent aerobic fitness; >10% suggests intensity exceeds sustainable aerobic capacity. Equivalent to act_summ_aerobic_decoupling when precomputed." .


#heart_rate_recovery_1min
:heart_rate_recovery_1min rdf:type owl:NamedIndividual ,
                                   :Scalar ,
                                   :Metabolic ,
                                   :Derived ;
                          :canBeComputedUsingFunction :function_compute_heart_rate_recovery ;
                          :derivedFrom :heart_rate ,
                                       :power ,
                                       :datetime ;
                          :hasRelation :activity_id ;
                          :measuredInUnits "bpm (beats per minute drop in 1 minute)" ;
                          :isPresentInDataset "false"^^xsd:boolean ;
                          rdfs:comment "Heart rate drop in the first minute after cessation of hard effort. HRR1 >40 bpm = excellent (elite), 30-40 = good (well-trained), 20-30 = moderate, <12 = poor (clinical concern). A robust marker of autonomic function and cardiovascular fitness." .


#heart_rate_recovery_2min
:heart_rate_recovery_2min rdf:type owl:NamedIndividual ,
                                   :Scalar ,
                                   :Metabolic ,
                                   :Derived ;
                          :canBeComputedUsingFunction :function_compute_heart_rate_recovery ;
                          :derivedFrom :heart_rate ,
                                       :power ,
                                       :datetime ;
                          :hasRelation :activity_id ;
                          :measuredInUnits "bpm (beats per minute drop in 2 minutes)" ;
                          :isPresentInDataset "false"^^xsd:boolean ;
                          rdfs:comment "Heart rate drop in the first two minutes after cessation of hard effort. Provides additional recovery information beyond HRR1, particularly useful for tracking recovery capacity over longer time horizons and for athletes with slower initial recovery." .


#torque
:torque rdf:type owl:NamedIndividual ,
                 :Timeseries ,
                 :Mechanical ,
                 :Derived ;
        :derivedFrom :cadence ,
                     :power ;
        :hasRelation :activity_id ,
                     :datetime ;
        :measuredInUnits "Newton Meters (Nm)" ;
        :derivedUsingFormula "torque = power × 60 / (2 × π × cadence). Where power is in watts and cadence is in RPM. Returns Nm. Undefined when cadence = 0." ;
        :isPresentInDataset "false"^^xsd:boolean ;
        rdfs:comment "Rotational force applied to the pedals, derived from power and cadence. Higher torque at lower cadence vs lower torque at higher cadence for same power. Useful for pedaling technique analysis and gear selection optimization." .


#power
:power rdf:type owl:NamedIndividual ,
                :ActivityMeasurement ,
                :DirectlyMeasured ,
                :Mechanical ;
       :hasRelation :activity_id ,
                    :activity_type ,
                    :datetime ;
       :isPresentInDataset "true"^^xsd:boolean ;
       :measuredInUnits "Watts" ;
       :recordedWithFrequency "1 Second" .


#respiration_rate
:respiration_rate rdf:type owl:NamedIndividual ,
                           :ActivityMeasurement ,
                           :DirectlyMeasured ,
                           :Metabolic ;
                  :hasRelation :activity_id ,
                               :activity_type ,
                               :datetime ;
                  :isPresentInDataset "true"^^xsd:boolean ;
                  :measuredInUnits "Breaths per Minute" ;
                  :recordedWithFrequency "1 Second" .


#speed
:speed rdf:type owl:NamedIndividual ,
                :ActivityMeasurement ,
                :PreComputed ,
                :Velocity ;
       :hasRelation :activity_id ,
                    :activity_type ,
                    :datetime ;
       :preComputedFrom :datetime ,
                        :distance ;
       :isPresentInDataset "true"^^xsd:boolean ;
       :measuredInUnits "Meters per Second" ;
       :recordedWithFrequency "1 Second" .


#tidal_volume
:tidal_volume rdf:type owl:NamedIndividual ,
                       :ActivityMeasurement ,
                       :DirectlyMeasured ,
                       :Metabolic ;
              :hasRelation :activity_id ,
                           :activity_type ,
                           :datetime ;
              :isPresentInDataset "true"^^xsd:boolean ;
              :measuredInUnits "mililiters (mL)" ;
              :recordedWithFrequency "1 Second" .


#tidal_volume_minute
:tidal_volume_minute rdf:type owl:NamedIndividual ,
                              :ActivityMeasurement ,
                              :DirectlyMeasured ,
                              :Metabolic ;
                     :hasRelation :activity_id ,
                                  :activity_type ,
                                  :datetime ;
                     :isPresentInDataset "true"^^xsd:boolean ;
                     :measuredInUnits "Liters per Minute (L/min)" ;
                     :recordedWithFrequency "1 Second" ;
                     rdfs:comment "A measure of the total volume of air that a person inhales or exhales in one minute." .


#well_atl
:well_atl rdf:type owl:NamedIndividual ,
                   :Derived ,
                   :Wellness ,
                   :WellnessIndex ;
          :hasRelation :date ;
          :isPresentInDataset "true"^^xsd:boolean ;
          :recordedWithFrequency "1 day" ;
          rdfs:comment "A short-term exponentially weighted moving average of daily training stress scores, representing recent training load and accumulated fatigue from recent exercise sessions." .


#well_atlLoad
:well_atlLoad rdf:type owl:NamedIndividual ,
                       :Derived ,
                       :Wellness ,
                       :WellnessIndex ;
              :hasRelation :date ;
              :isPresentInDataset "true"^^xsd:boolean ;
              :recordedWithFrequency "1 Day" .


#well_averageSleepingHR
:well_averageSleepingHR rdf:type owl:NamedIndividual ,
                                 :DirectlyMeasured ,
                                 :Wellness ,
                                 :WellnessAggregate ;
                        :hasRelation :date ;
                        :isPresentInDataset "true"^^xsd:boolean ;
                        :measuredInUnits "BPM" ;
                        :recordedWithFrequency "1 Day" .


#well_ctl
:well_ctl rdf:type owl:NamedIndividual ,
                   :Derived ,
                   :Wellness ,
                   :WellnessIndex ;
          :hasRelation :date ;
          :isPresentInDataset "true"^^xsd:boolean ;
          :recordedWithFrequency "1 Day" ;
          rdfs:comment "A rolling weighted average of daily training stress scores over an extended period , representing accumulated fitness and aerobic base development in endurance training periodization." .


#well_ctlLoad
:well_ctlLoad rdf:type owl:NamedIndividual ,
                       :Derived ,
                       :Wellness ,
                       :WellnessIndex ;
              :hasRelation :date ;
              :isPresentInDataset "true"^^xsd:boolean ;
              :recordedWithFrequency "1 Day" .


#well_hrv
:well_hrv rdf:type owl:NamedIndividual ,
                   :DirectlyMeasured ,
                   :Wellness ,
                   :WellnessAggregate ;
          :hasRelation :date ;
          :isPresentInDataset "true"^^xsd:boolean ;
          :measuredInUnits "MiliSeconds" ;
          :recordedWithFrequency "1 Day" ;
          rdfs:comment "well_hrv represents the variation in time between consecutive heartbeats" .


#well_rampRate
:well_rampRate rdf:type owl:NamedIndividual ,
                        :Derived ,
                        :Wellness ,
                        :WellnessIndex ;
               :hasRelation :date ;
               :isPresentInDataset "true"^^xsd:boolean ;
               :recordedWithFrequency "1 Day" ;
               rdfs:comment "The rate of training load progression calculated as the ratio or difference between acute and chronic training loads, quantifying the relative intensity of current training compared to established fitness baseline." .


#well_readiness
:well_readiness rdf:type owl:NamedIndividual ,
                         :Derived ,
                         :Wellness ,
                         :WellnessIndex ;
                :hasRelation :date ;
                :isPresentInDataset "true"^^xsd:boolean ;
                :recordedWithFrequency "1 Day" ;
                rdfs:comment "A composite daily physiological recovery index (0-100) that quantifies an individual's physical and mental preparedness for daily activities" .


#well_restingHR
:well_restingHR rdf:type owl:NamedIndividual ,
                         :DirectlyMeasured ,
                         :Metabolic ,
                         :WellnessAggregate ;
                :hasRelation :date ;
                :isPresentInDataset "true"^^xsd:boolean ;
                :measuredInUnits "BPM" ;
                :recordedWithFrequency "1 Day" .


#well_sleepQuality
:well_sleepQuality rdf:type owl:NamedIndividual ,
                            :Derived ,
                            :Wellness ,
                            :WellnessIndex ;
                   :hasRelation :date ;
                   :isPresentInDataset "true"^^xsd:boolean ;
                   :recordedWithFrequency "1 Day" ;
                   rdfs:comment "An ordinal categorical assessment of overall sleep performance that evaluates the restorative value and characteristics of a sleep period" .


#well_sleepSaec
:well_sleepSaec rdf:type owl:NamedIndividual ,
                         :DirectlyMeasured ,
                         :Wellness ,
                         :WellnessAggregate ;
                :hasRelation :date ;
                :isPresentInDataset "true"^^xsd:boolean ;
                :measuredInUnits "Seconds" ;
                :recordedWithFrequency "1 Day" .


#well_sleepScore
:well_sleepScore rdf:type owl:NamedIndividual ,
                          :Derived ,
                          :Wellness ,
                          :WellnessIndex ;
                 :hasRelation :date ;
                 :isPresentInDataset "true"^^xsd:boolean ;
                 :recordedWithFrequency "1 Day" .


#well_steps
:well_steps rdf:type owl:NamedIndividual ,
                     :PreComputed ,
                     :Wellness ,
                     :WellnessAggregate ;
            :hasRelation :date ;
            :isPresentInDataset "true"^^xsd:boolean ;
            :measuredInUnits "Steps (count)" ;
            :recordedWithFrequency "1 Day" ;
            rdfs:comment "Total step count for the day, aggregated from continuous activity monitoring." .


#well_vo2max
:well_vo2max rdf:type owl:NamedIndividual ,
                      :PreComputed ,
                      :Wellness ,
                      :WellnessIndex ;
             :hasRelation :date ;
             :isPresentInDataset "true"^^xsd:boolean ;
             :recordedWithFrequency "1 Day" ;
             rdfs:comment "The maximum rate of oxygen consumption attainable during maximal physical exertion, representing the gold standard measure of aerobic fitness and cardiovascular endurance capacity" .


#wellness_dataframe
:wellness_dataframe rdf:type owl:NamedIndividual ,
                             :Auxiliary ,
                             :WellnessSummaryDataframe ;
                    :containsWellnessAggregate :well_averageSleepingHR ,
                                               :well_hrv ,
                                               :well_restingHR ,
                                               :well_sleepSaec ,
                                               :well_steps ;
                    :containsWellnessIndex :well_atl ,
                                           :well_atlLoad ,
                                           :well_ctl ,
                                           :well_ctlLoad ,
                                           :well_rampRate ,
                                           :well_readiness ,
                                           :well_sleepQuality ,
                                           :well_sleepScore ,
                                           :well_vo2max ;
                    :groupedBy :date ;
                    :hasKey :date ;
                    rdfs:comment "A container of daily wellness metrics tracking various health-related indicators, with each row representing a single day's measurements across multiple dimensions of well-being. Indexed by date." .

