#act_summ_avg_stride_length
:act_summ_avg_stride_length rdf:type owl:NamedIndividual ,
                                     :ActivityAggregate ,
                                     :DirectlyMeasured ,
                                     :Mechanical ;
                            :hasRelation :act_summ_activity_id ;
                            :isPresentInDataset "true"^^xsd:boolean ;
