#act_summ_elevation_gain
:act_summ_elevation_gain rdf:type owl:NamedIndividual ,
                                  :ActivityAggregate ,
                                  :DirectlyMeasured ,
                                  :Geospatial ;
                         :hasRelation :act_summ_activity_id ;
                         :isPresentInDataset "true"^^xsd:boolean ;
