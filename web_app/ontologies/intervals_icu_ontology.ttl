                               :hasRelation :int_summ_lap_number ;
                               :isPresentInDataset "true"^^xsd:boolean ;
                               :measuredInUnits "mililiters (mL)" ;
                               :recordedWithFrequency "Per Interval" .


#int_summ_average_tidal_volume_min
