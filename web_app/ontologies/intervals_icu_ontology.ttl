                        :measuredInUnits "Meters per second" ;
                        :recordedWithFrequency "Per Interval" .


#int_summ_average_tidal_volume
:int_summ_average_tidal_volume rdf:type owl:NamedIndividual ,
                                        :DirectlyMeasured ,
