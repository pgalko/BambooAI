                                  :DirectlyMeasured ,
                                  :Geospatial ;
                         :hasRelation :act_summ_activity_id ;
                         :isPresentInDataset "true"^^xsd:boolean ;
                         :measuredInUnits "Meters" ;
                         :recordedWithFrequency "Per Activity" .


