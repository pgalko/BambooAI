#activity
:activity rdf:type owl:NamedIndividual ,
                   :Activity ;
          :containsActivityMeasurement :air_temperature ,
                                       :altitude ,
                                       :cadence ,
                                       :datetime ,
                                       :distance ,
                                       :heart_rate ,
                                       :latitude ,
                                       :left_right_balance ,
                                       :longitude ,
                                       :power ,
                                       :respiration_rate ,
                                       :speed ,
                                       :tidal_volume ,
                                       :tidal_volume_minute ;
          :containsInterval :activity_interval ;
          :hasKey :activity_id ,
                  :activity_name ,
                  :activity_type ,
                  :datetime ;
          :hasUniqueIdentifier :activity_id .


#activity_dataframe
:activity_dataframe rdf:type owl:NamedIndividual ,
                             :ActivityDataframe ,
                             :Primary ;
                    :containsActivity :activity ;
                    :groupedBy :activity_id .


#activity_id
:activity_id rdf:type owl:NamedIndividual ,
                      :Key ;
             :hasRelation :act_summ_activity_id ,
                          :athlete_id ,
                          :int_summ_activity_id ;
             :isPresentInDataset "true"^^xsd:boolean .


#activity_interval
:activity_interval rdf:type owl:NamedIndividual ,
                            :ActivityInterval ;
                   :groupedBy :datetime ;
                   :hasKey :datetime ;
                   :hasUniqueIdentifier :datetime ;
                   rdfs:comment "An activity interval (or \"lap\") represents measurements from a specific segment of an activity, defined by time or distance." .


#activity_intervals_dataframe
:activity_intervals_dataframe rdf:type owl:NamedIndividual ,
                                       :Auxiliary ,
                                       :Index ,
                                       :IntervalsSummaryDataframe ;
                              :containsIntervalAggregate :int_summ_average_cadence ,
