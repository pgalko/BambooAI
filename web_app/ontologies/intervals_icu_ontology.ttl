@prefix : <http://www.semanticweb.org/owl/owlapi/turtle#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/owl/owlapi/turtle#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Object Properties
#################################################################

#applicableToDataObject
:applicableToDataObject rdf:type owl:ObjectProperty ;
                        rdfs:domain :Function ;
                        rdfs:range :DataObjects .


#canBeComputedUsingFunction
:canBeComputedUsingFunction rdf:type owl:ObjectProperty ;
                            rdfs:domain :DataObjects ;
                            rdfs:range :Function .


#containsActivity
:containsActivity rdf:type owl:ObjectProperty ;
                  rdfs:domain :ActivityDataframe ;
                  rdfs:range :Activity .


#containsActivityAggregate
:containsActivityAggregate rdf:type owl:ObjectProperty ;
                           rdfs:domain :ActivitySummaryDataframe ;
                           rdfs:range :ActivityAggregate .


#containsActivityIndex
:containsActivityIndex rdf:type owl:ObjectProperty ;
                       rdfs:domain :ActivitySummaryDataframe ;
                       rdfs:range :ActivityIndex .


#containsActivityMeasurement
:containsActivityMeasurement rdf:type owl:ObjectProperty ;
                             rdfs:domain :Activity ;
                             rdfs:range :MeasurementCategory .


#containsInterval
:containsInterval rdf:type owl:ObjectProperty ;
                  rdfs:domain :Activity ;
                  rdfs:range :ActivityInterval .


#containsIntervalAggregate
:containsIntervalAggregate rdf:type owl:ObjectProperty ;
                           rdfs:domain :IntervalsSummaryDataframe ;
                           rdfs:range :IntervalAggregate .


#containsIntervalIndex
:containsIntervalIndex rdf:type owl:ObjectProperty ;
                       rdfs:domain :IntervalsSummaryDataframe ;
                       rdfs:range :IntervalIndex .


#containsLap
:containsLap rdf:type owl:ObjectProperty ;
             rdfs:domain :Activity .


#containsSegment
:containsSegment rdf:type owl:ObjectProperty ;
                 rdfs:domain :Activity .


#containsWellnessAggregate
:containsWellnessAggregate rdf:type owl:ObjectProperty ;
                           rdfs:domain :WellnessSummaryDataframe ;
                           rdfs:range :WellnessAggregate .


#containsWellnessIndex
:containsWellnessIndex rdf:type owl:ObjectProperty ;
                       rdfs:domain :WellnessSummaryDataframe ;
                       rdfs:range :WellnessIndex .


#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :Derived ;
             rdfs:range :DirectlyMeasured ,
                        :PreComputed ,
                        :Derived ;
             rdfs:comment "Links a derived metric to the measurements or other derived metrics it is computed from. Can point to DirectlyMeasured, PreComputed, or other Derived metrics." .


#functionRequiresMeasurements
:functionRequiresMeasurements rdf:type owl:ObjectProperty ;
                              rdfs:domain :Function ;
                              rdfs:range :Measurement ;
                              rdfs:comment "Links a function to the specific measurement instances it requires as raw input data." .


#groupedBy
:groupedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :DataObjects ;
           rdfs:range :Key .


#hasKey
:hasKey rdf:type owl:ObjectProperty ;
        rdfs:domain :Index ,
                    :Timeseries ;
        rdfs:range :Key .


#hasRelation
:hasRelation rdf:type owl:ObjectProperty ;
             rdfs:domain :Key ,
                         :Measurement ;
             rdfs:range :Key .


#hasUniqueIdentifier
:hasUniqueIdentifier rdf:type owl:ObjectProperty ;
                     rdfs:domain :DataObjects ,
                                 :MeasurementCategory ;
                     rdfs:range :Key .


#preComputedFrom
:preComputedFrom rdf:type owl:ObjectProperty ;
                 rdfs:domain :PreComputed ;
                 rdfs:range :DirectlyMeasured ,
                            :PreComputed .


#alternativeTo
:alternativeTo rdf:type owl:ObjectProperty ;
               rdfs:domain :Function ;
               rdfs:range :Function ;
               rdfs:comment "Links to other functions that address similar analytical questions, enabling technique selection reasoning." .


#addressesConcept
:addressesConcept rdf:type owl:ObjectProperty ;
                  rdfs:domain :Function ;
                  rdfs:range :Concept ;
                  rdfs:comment "Links a Function or Derived Metric to the Concept(s) it addresses. Enables discovery of relevant analytical tools from conceptual questions." .


#producesOutputs
:producesOutputs rdf:type owl:ObjectProperty ;
                 rdfs:domain :Function ;
                 rdfs:range :Derived ;
                 rdfs:comment "Links a function to the derived metrics it produces. Used for functions that output multiple related metrics as a set." .


#functionRequiresDerivedMetrics
:functionRequiresDerivedMetrics rdf:type owl:ObjectProperty ;
                                rdfs:domain :Function ;
                                rdfs:range :Derived ;
                                rdfs:comment "Links a function to derived metrics it requires as input. Distinct from functionRequiresMeasurements which specifies raw sensor data." .


#equivalentToPrecomputed
:equivalentToPrecomputed rdf:type owl:ObjectProperty ;
                         rdfs:domain :Derived ;
                         rdfs:range :PreComputed ;
                         rdfs:comment "Links a derived metric to its precomputed equivalent in summary dataframes, enabling traceability between on-demand calculations and stored values." .


#dependsOnFunction
:dependsOnFunction rdf:type owl:ObjectProperty ;
                   rdfs:domain :Function ;
                   rdfs:range :Function ;
                   rdfs:comment "Indicates that a function depends on another function being executed first. Creates explicit function chaining." .


#dependsOnDerivedMetric
:dependsOnDerivedMetric rdf:type owl:ObjectProperty ;
                        rdfs:domain :Derived ;
                        rdfs:range :Derived ;
                        rdfs:comment "Links a derived metric to other derived metrics it depends on for computation." .


#functionRequiresParameter
:functionRequiresParameter rdf:type owl:ObjectProperty ;
                           rdfs:domain :Function ;
                           rdfs:range :Parameter ;
                           rdfs:comment "Links a function to external parameters it requires beyond measurements, such as reference datasets or configuration values." .


#complementedBy
:complementedBy rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain :Function ;
                rdfs:range :Function ;
                rdfs:comment "Links functions that provide complementary (not alternative) analyses. Symmetric property - if A complements B, then B complements A." .


#################################################################
#    Data properties
#################################################################

#allowedValues
:allowedValues rdf:type owl:DatatypeProperty ;
               rdfs:domain :Key ;
               rdfs:range xsd:string .


#computeTimeseriesStats
:computeTimeseriesStats rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Timeseries ;
                        rdfs:range xsd:string .


#derivedUsingFormula
:derivedUsingFormula rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Measurement ;
                     rdfs:range xsd:string .


#functionDefinition
:functionDefinition rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Function ;
                    rdfs:range xsd:string .


#isPresentInDataset
:isPresentInDataset rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Key ,
                                :Measurement ;
                    rdfs:range xsd:boolean .


#measuredInUnits
:measuredInUnits rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Measurement ;
                 rdfs:range xsd:string .


#recordedWithFrequency
:recordedWithFrequency rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Measurement ;
                       rdfs:range xsd:string .


#answersQuestion
:answersQuestion rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Function ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The core analytical question this function addresses in the sports science domain." .


#physiologicalBasis
:physiologicalBasis rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Function ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The underlying physiological, biomechanical, or metabolic principles that explain why this analysis is meaningful." .


#interpretationGuide
:interpretationGuide rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Function ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Guidance on how to read, interpret, and derive insights from the function's output." .


#useWhen
:useWhen rdf:type owl:DatatypeProperty ;
         rdfs:domain :Function ;
         rdfs:range xsd:string ;
         rdfs:comment "Conditions and scenarios where this analytical technique is appropriate and valuable." .


#outputShape
:outputShape rdf:type owl:DatatypeProperty ;
             rdfs:domain :Function ;
             rdfs:range xsd:string ;
             rdfs:comment "Describes the structure and format of the function's output." .


#assumes
:assumes rdf:type owl:DatatypeProperty ;
         rdfs:domain :Function ;
         rdfs:range xsd:string ;
         rdfs:comment "Conditions and assumptions that must hold for the function to produce valid results." .


#limitations
:limitations rdf:type owl:DatatypeProperty ;
             rdfs:domain :Function ;
             rdfs:range xsd:string ;
             rdfs:comment "Known limitations, edge cases, and potential failure modes of the function." .


#answersQuestions
:answersQuestions rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Concept ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Free text describing the types of user questions this concept addresses." .


#errorBehavior
:errorBehavior rdf:type owl:DatatypeProperty ;
               rdfs:domain :Function ;
               rdfs:range xsd:string ;
               rdfs:comment "Describes what happens when function assumptions are violated or required data is missing/invalid." .


#minimumDuration
:minimumDuration rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Function ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Minimum activity or interval duration required for meaningful function output." .


#defaultParameters
:defaultParameters rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Function ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Default parameter values used when not explicitly specified." .


#################################################################
#    Classes
#################################################################

#Activity
:Activity rdf:type owl:Class ;
          rdfs:subClassOf :Timeseries ;
          rdfs:comment "A single activity session, containing multiple rows of measurements at regular intervals." .


#ActivityAggregate
:ActivityAggregate rdf:type owl:Class ;
                   rdfs:subClassOf :Measurement ;
                   rdfs:comment "A single value in the activity_summary_dataframe, representing a particular activity metric aggregate for a specific activity (activity_id)." .


#ActivityDataframe
:ActivityDataframe rdf:type owl:Class ;
                   rdfs:subClassOf :Dataframe ;
                   rdfs:comment "A container for multiple activities and coresponding measurements, organized as time series data." .


#ActivityIndex
:ActivityIndex rdf:type owl:Class ;
               rdfs:subClassOf :Measurement ;
               rdfs:comment "A single value in the activity_summary_dataframe, representing a particular activity index for a specific activity (activity_id)." .


#ActivityInterval
:ActivityInterval rdf:type owl:Class ;
                  rdfs:subClassOf :Timeseries .


#ActivityMeasurement
:ActivityMeasurement rdf:type owl:Class ;
                     rdfs:subClassOf :Measurement ;
                     rdfs:comment "A single value in the ActivityDataframee, representing measurements at a specific timestamp within an activity." .


#ActivitySummaryDataframe
:ActivitySummaryDataframe rdf:type owl:Class ;
                          rdfs:subClassOf :Dataframe ;
                          rdfs:comment "activity_id-indexed summary providing a condensed view of Activities  with aggregated metrics. Enables quick filtering and reference to detailed data in the original Dataframe." .


#Assessed
:Assessed rdf:type owl:Class ;
                  rdfs:subClassOf :MeasurementType .

#Auxiliary
:Auxiliary rdf:type owl:Class ;
           rdfs:subClassOf :DatasourceType .


#Behavioral
:Behavioral rdf:type owl:Class ;
            rdfs:subClassOf :MeasurementCategory .


#DataObjects
:DataObjects rdf:type owl:Class .


#Dataframe
:Dataframe rdf:type owl:Class ;
           rdfs:subClassOf :Timeseries .


#DatasourceType
:DatasourceType rdf:type owl:Class .


#Derived
:Derived rdf:type owl:Class ;
         rdfs:subClassOf :MeasurementType .


#Dictionary
:Dictionary rdf:type owl:Class ;
            rdfs:subClassOf :DataObjects .


#DirectlyMeasured
:DirectlyMeasured rdf:type owl:Class ;
                  rdfs:subClassOf :MeasurementType .


#Environmental
:Environmental rdf:type owl:Class ;
               rdfs:subClassOf :MeasurementCategory .


#Function
:Function rdf:type owl:Class .


#Geospatial
:Geospatial rdf:type owl:Class ;
            rdfs:subClassOf :MeasurementCategory .


#Index
:Index rdf:type owl:Class ;
       rdfs:subClassOf :DataObjects .


#Instrument
:Instrument rdf:type owl:Class .


#IntervalAggregate
:IntervalAggregate rdf:type owl:Class ;
                   rdfs:subClassOf :Measurement .


#IntervalIndex
:IntervalIndex rdf:type owl:Class ;
               rdfs:subClassOf :Measurement .


#IntervalsSummaryDataframe
:IntervalsSummaryDataframe rdf:type owl:Class ;
                           rdfs:subClassOf :Dataframe .


#Key
:Key rdf:type owl:Class .


#List
:List rdf:type owl:Class ;
      rdfs:subClassOf :DataObjects ;
      rdfs:comment "A list of computed values" .


#Measurement
:Measurement rdf:type owl:Class ;
             rdfs:subClassOf :DataObjects .


#MeasurementCategory
:MeasurementCategory rdf:type owl:Class .


#MeasurementType
:MeasurementType rdf:type owl:Class .


#Mechanical
:Mechanical rdf:type owl:Class ;
            rdfs:subClassOf :MeasurementCategory .


#Metabolic
:Metabolic rdf:type owl:Class ;
           rdfs:subClassOf :MeasurementCategory .


#PreComputed
:PreComputed rdf:type owl:Class ;
             rdfs:subClassOf :MeasurementType .


#Primary
:Primary rdf:type owl:Class ;
         rdfs:subClassOf :DatasourceType .


#Scalar
:Scalar rdf:type owl:Class ;
        rdfs:subClassOf :DataObjects .


#Temporal
:Temporal rdf:type owl:Class ;
          rdfs:subClassOf :MeasurementCategory .


#Timeseries
:Timeseries rdf:type owl:Class ;
            rdfs:subClassOf :DataObjects ;
            rdfs:comment "A sequence of records indexed in time order." .


#TrainingStress
:TrainingStress rdf:type owl:Class ;
                rdfs:subClassOf :MeasurementCategory .


#Velocity
:Velocity rdf:type owl:Class ;
          rdfs:subClassOf :MeasurementCategory .


#VisualObjects
:VisualObjects rdf:type owl:Class .


#Wellness
:Wellness rdf:type owl:Class ;
          rdfs:subClassOf :MeasurementCategory .


#WellnessAggregate
:WellnessAggregate rdf:type owl:Class ;
                   rdfs:subClassOf :Measurement ;
                   rdfs:comment "A single value in the wellness_summary_dataframe, representing aggregate for a specific time window (24 hours) for a particular wellness metric or health indicator." .


#WellnessIndex
:WellnessIndex rdf:type owl:Class ;
               rdfs:subClassOf :Measurement .


#WellnessSummaryDataframe
:WellnessSummaryDataframe rdf:type owl:Class ;
                          rdfs:subClassOf :Dataframe ;
                          rdfs:comment "A container of daily wellness metrics tracking various health-related indicators, with each row representing a single day's measurements across multiple dimensions of well-being." .


#Concept
:Concept rdf:type owl:Class ;
         rdfs:comment "A domain concept representing an analytical concern or methodology in sports science. Concepts bridge user questions to the functions and metrics that address them." .


#Parameter
:Parameter rdf:type owl:Class ;
           rdfs:comment "External parameter required by a function, such as reference datasets or configuration values." .


#RampTestActivity
:RampTestActivity rdf:type owl:Class ;
                  rdfs:subClassOf :Activity ;
                  rdfs:comment "A structured ramp test activity with progressive intensity increase, required for ventilatory threshold detection." .


#################################################################
#    Individuals
#################################################################


#concept_power_capacity_profiling
:concept_power_capacity_profiling rdf:type owl:NamedIndividual ,
                                           :Concept ;
                                  rdfs:label "Power Capacity Profiling" ;
                                  :answersQuestions "What are my strengths and weaknesses? Am I a sprinter or a climber? What events suit me? How do I compare to other athletes? What is my power profile?" ;
                                  rdfs:comment "Understanding an athlete's capabilities across the power-duration spectrum, revealing their physiological phenotype and identifying relative strengths and weaknesses at different durations." .


#concept_threshold_determination
:concept_threshold_determination rdf:type owl:NamedIndividual ,
                                          :Concept ;
                                 rdfs:label "Threshold Determination" ;
                                 :answersQuestions "What is my FTP? What zones should I train in? What intensity can I sustain for an hour? What is my lactate threshold? What is my critical power? What are my ventilatory thresholds (VT1, VT2)? At what intensity do I cross from aerobic to anaerobic?" ;
                                 rdfs:comment "Establishing the metabolic boundary between sustainable and unsustainable exercise intensity, which serves as the anchor point for training zone prescription and performance prediction. Can be determined through power-based methods (FTP, CP) or ventilatory methods (VT1, VT2) - ventilatory thresholds provide a more physiologically grounded alternative when breathing data is available." .


#concept_training_load_quantification
:concept_training_load_quantification rdf:type owl:NamedIndividual ,
                                               :Concept ;
                                      rdfs:label "Training Load Quantification" ;
                                      :answersQuestions "How hard was that workout? How does today compare to yesterday? Am I training enough? How much stress did that ride create? What was my training load? How much internal strain did that effort cause? Is my breathing pattern showing fatigue?" ;
                                      rdfs:comment "Measuring the dose of training stress from individual workouts, enabling comparison across different workout types and accumulation tracking over time. Can be quantified through power-based metrics (NP, IF, TSS) or ventilatory markers (breathing rate drift) - ventilatory drift provides insight into internal load that may not be visible in external power metrics." .


#concept_fitness_fatigue_modeling
:concept_fitness_fatigue_modeling rdf:type owl:NamedIndividual ,
                                           :Concept ;
                                  rdfs:label "Fitness-Fatigue Modeling" ;
                                  :answersQuestions "Am I getting fitter? Am I overtrained? When should I race? How should I taper? Am I ready to perform? What is my form? What is my CTL?" ;
                                  rdfs:comment "Tracking the accumulation and decay of fitness and fatigue over time to model an athlete's readiness to perform. Foundation for periodization and taper planning." .


#concept_pacing
:concept_pacing rdf:type owl:NamedIndividual ,
                              :Concept ;
                     rdfs:label "Pacing & Execution" ;
                     :answersQuestions "Did I pace well? When did I blow up? How should I pace my next race? How much do I have left? Was my effort too variable? What is my W' balance? Is my breathing showing I'm overcooking it? Am I accumulating fatigue I can't see in power?" ;
                     rdfs:comment "Analyzing and optimizing power distribution during competition, managing finite anaerobic capacity to maximize performance without premature exhaustion. Power-based tools (W'bal, VI) track external load while ventilatory tools (breathing drift) reveal internal strain - combining both provides a complete picture of pacing sustainability." .


#concept_metabolic_profiling
:concept_metabolic_profiling rdf:type owl:NamedIndividual ,
                                      :Concept ;
                             rdfs:label "Metabolic Profiling" ;
                             :answersQuestions "How efficient is my metabolism? At what intensity do I switch from fat to carbs? How has my metabolic efficiency changed? What should my nutrition strategy be? What are my ventilatory thresholds? How does my heart rate respond to effort? Is my aerobic system improving? What is my cardiac drift? How quickly does my heart rate recover?" ;
                             rdfs:comment "Understanding an athlete's metabolic efficiency and energy system utilization through physiological markers including ventilation, heart rate, and their relationships to power output. Reveals fuel utilization transitions (VT1, Balance Point, VT2), cardiovascular efficiency (HR:power coupling, cardiac drift), and recovery capacity (HR recovery). These physiological metrics provide insight into internal state that power alone cannot reveal, informing training prescription, adaptation tracking, and race-day strategy." .


#reference_population_data
:reference_population_data rdf:type owl:NamedIndividual ,
                                    :Parameter ;
                           rdfs:comment "Reference population dataset for percentile calculations. Should specify gender, age range, and performance level." .


#recovery_duration_seconds
:recovery_duration_seconds rdf:type owl:NamedIndividual ,
                                    :Parameter ;
                           rdfs:comment "Duration in seconds after effort cessation for heart rate recovery measurement. Common values: 60 (HRR1), 120 (HRR2)." .


#act_summ_activity_id
:act_summ_activity_id rdf:type owl:NamedIndividual ,
                               :Key ;
                      :hasRelation :athlete_id ;
                      :isPresentInDataset "true"^^xsd:boolean .


#act_summ_aerobic_decoupling
:act_summ_aerobic_decoupling rdf:type owl:NamedIndividual ,
                                      :ActivityIndex ,
                                      :Metabolic ,
                                      :PreComputed ;
                             :hasRelation :act_summ_activity_id ;
                             :isPresentInDataset "true"^^xsd:boolean ;
                             :measuredInUnits "Custom" ;
                             :recordedWithFrequency "Per Activity" ;
                             rdfs:comment "The drift between power and heart rate within a single workout (typically comparing the first and second halves of a steady ride or run)" .


#act_summ_athlete_weight_kg
:act_summ_athlete_weight_kg rdf:type owl:NamedIndividual ,
                                     :ActivityIndex ,
                                     :Metabolic ,
                                     :PreComputed ;
                            :hasRelation :act_summ_activity_id ;
                            :isPresentInDataset "true"^^xsd:boolean ;
                            :measuredInUnits "kilograms (kg)" ;
                            :recordedWithFrequency "Per Activity" .


#act_summ_average_power
:act_summ_average_power rdf:type owl:NamedIndividual ,
                                 :ActivityAggregate ,
                                 :DirectlyMeasured ,
                                 :Mechanical ;
                        :hasRelation :act_summ_activity_id ;
                        :isPresentInDataset "true"^^xsd:boolean ;
                        :measuredInUnits "Watts" ;
                        :recordedWithFrequency "Per Activity" .


#act_summ_avg_altitude_m
:act_summ_avg_altitude_m rdf:type owl:NamedIndividual ,
