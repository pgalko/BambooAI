                     :Metabolic ;
            :hasRelation :activity_id ,
                         :activity_type ,
                         :datetime ;
            :isPresentInDataset "true"^^xsd:boolean ;
            :measuredInUnits "BPM" ;
            :recordedWithFrequency "1 Second" .


