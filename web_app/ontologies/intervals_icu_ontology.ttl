                                                         :int_summ_average_respiration ,
                                                         :int_summ_average_speed ,
                                                         :int_summ_average_tidal_volume ,
                                                         :int_summ_average_tidal_volume_min ,
                                                         :int_summ_average_torque ,
                                                         :int_summ_average_watts ,
                                                         :int_summ_average_weather_temp ,
                                                         :int_summ_average_wind_gust ,
                                                         :int_summ_average_wind_speed ,
                                                         :int_summ_average_yaw ,
                                                         :int_summ_avg_lr_balance ,
                                                         :int_summ_distance ,
                                                         :int_summ_elapsed_time ,
                                                         :int_summ_headwind_percent ,
                                                         :int_summ_joules ,
                                                         :int_summ_lactate , 
                                                         :int_summ_rpe ,      
                                                         :int_summ_max_altitude ,
                                                         :int_summ_min_altitude ,
                                                         :int_summ_moving_time ,
                                                         :int_summ_prevailing_wind_deg ,
                                                         :int_summ_tailwind_percent ,
                                                         :int_summ_total_elevation_gain ;
                              :groupedBy :int_summ_activity_id ;
                              :hasKey :int_summ_activity_id ,
                                      :int_summ_end_time ,
                                      :int_summ_lap_number ,
                                      :int_summ_label ,
                                      :int_summ_start_time ;
                              rdfs:comment "A summary dataframe that acts as an index for activity intervals, storing activity_id, lap_number, and measurement aggregates and indexes to enable quick identification and retrieval of specific interval data" .


#activity_name
